(text "50 MHz / 200 ns command dead time\n64 commands + shared EN / RDY / FLT\nLogical HDL ports; FPGA pinout pending" (at 619.7600 411.4800 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "a9d26c9f-8213-5276-b5d7-449a63db6937"))
