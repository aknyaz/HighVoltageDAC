(text ".tran 200n 100m 0 200n\n.options reltol=1e-6 abstol=1e-12" (at 314.9600 213.3600 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "98dbf7e6-e347-531a-833d-9ded4cc00042"))
(text "PCM: 1 kHz sine, 90% FS\n192 kS/s, 4 bits, 1 ns edges\nEvaluate settled output at 92-100 ms." (at 314.9600 233.6800 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "ced90b4b-3cbc-5e0d-b59e-eaba418648e1"))
(text "SPDT: CTRL=1 selects 5 V; CTRL=0 selects return. Model contains two complementary idealized switches." (at 20.3200 269.2400 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "0175dab9-5a02-58b4-a0a4-57aaea552cb2"))
